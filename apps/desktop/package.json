{
  "name": "desktop",
  "version": "0.0.0",
  "private": true,
  "description": "OpenWarden desktop app",
  "author": "OpenWarden",
  "type": "module",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "clean:electron-build": "node -e \"require('node:fs').rmSync('.vite/build', { recursive: true, force: true })\"",
    "dev": "VITE_DESKTOP_FALLBACK=browser vp dev",
    "dev:renderer": "vp dev",
    "dev:electron": "pnpm run clean:electron-build && concurrently -k -n renderer,main,preload,electron -c auto \"pnpm run dev:renderer\" \"vp build --watch --config vite.main.config.ts\" \"vp build --watch --config vite.preload.config.ts\" \"node ./scripts/dev-electron.mjs\"",
    "electron:dev": "pnpm run dev:electron",
    "build": "pnpm run clean:electron-build && tsgo -b && vp build && vp build --config vite.main.config.ts && vp build --config vite.preload.config.ts",
    "typecheck": "tsgo --noEmit --pretty false -p tsconfig.app.json && tsgo --noEmit --pretty false -p tsconfig.electron.json",
    "build:electron": "pnpm run build && electron-builder --config electron-builder.config.mjs --dir --publish never",
    "electron:build": "pnpm run build:electron",
    "make:electron": "pnpm run build && electron-builder --config electron-builder.config.mjs --publish never",
    "electron:make": "pnpm run make:electron",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "preview": "vp preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@m2d/react-markdown": "^1.0.0",
    "@pierre/diffs": "1.1.19",
    "@reduxjs/toolkit": "^2.11.2",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-pacer": "^0.22.0",
    "@tanstack/react-virtual": "^3.13.24",
    "better-sqlite3": "^12.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.1",
    "electron-updater": "^6.8.3",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.11.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.9",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.74.0",
    "react-redux": "^9.2.0",
    "react-resizable-panels": "^4.10.0",
    "react-router": "^7.14.2",
    "recharts": "3.8.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "beta",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "41.3.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^29.0.2",
    "shadcn": "^4.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wait-on": "^9.0.5"
  }
}
