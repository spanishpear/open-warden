{
  "name": "open-warden",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vp run --filter desktop dev",
    "dev:electron": "pnpm --filter desktop dev:electron",
    "electron:dev": "pnpm --filter desktop electron:dev",
    "build": "vp run --filter desktop build",
    "build:electron": "pnpm --filter desktop build:electron",
    "electron:build": "pnpm --filter desktop electron:build",
    "make:electron": "pnpm --filter desktop make:electron",
    "electron:make": "pnpm --filter desktop electron:make",
    "lint": "vp lint --report-unused-disable-directives",
    "typecheck": "pnpm --filter desktop typecheck",
    "test": "vp run --filter desktop test",
    "test:pr-inbox": "pnpm --dir apps/desktop exec vp test run --config vitest.config.ts electron/bitbucket-repo.test.ts electron/inbox/orchestrator.test.ts electron/inbox/bitbucket-inbox.test.ts electron/inbox/pr-cache.test.ts electron/inbox/content-cache.test.ts electron/inbox/identity.test.ts electron/hosted-repos/pullRequests.test.ts electron/preload.test.ts src/features/inbox/screens/InboxScreen.test.tsx src/features/inbox/hooks/useInboxNavigation.test.ts src/features/diff-view/services/parsedDiffCache.test.ts",
    "check:pr-inbox": "pnpm --filter desktop typecheck && pnpm test:pr-inbox",
    "test:e2e": "pnpm --filter desktop test:e2e",
    "test:e2e:install": "pnpm --filter desktop test:e2e:install",
    "fmt": "vp fmt --ignore-path .oxfmtignore",
    "fmt:check": "vp fmt --check --ignore-path .oxfmtignore",
    "format": "pnpm fmt",
    "format:check": "pnpm fmt:check",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm fmt:check",
    "prepare": "vp config"
  },
  "devDependencies": {
    "knip": "^6.7.0",
    "vite-plus": "catalog:"
  },
  "engines": {
    "engines": {
      "node": ">=22"
    },
    "os": [
      "darwin",
      "linux"
    ],
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "electron-builder-squirrel-windows"
      ]
    }
  }
}
